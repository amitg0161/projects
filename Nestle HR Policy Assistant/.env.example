# "auto" uses OpenAI when OPENAI_API_KEY is set; otherwise it uses Ollama.
# You can also select "openai" or "ollama" explicitly. OpenAI without a key falls back to Ollama.
LLM_PROVIDER=auto

# OpenAI provider (GPT-3.5 Turbo and OpenAI embeddings).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama provider (pull both configured models locally first).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Relative paths are resolved from the project folder.
POLICY_PDF_DIR=HR_policy_pdf
VECTOR_STORE_DIR=.chroma

# Retrieval and text splitting.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4
MIN_RELEVANCE_SCORE=0.15

# Local-only Gradio listener by default.
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860